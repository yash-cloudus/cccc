# DATABASE_URL lives in `.env` — the Prisma CLI cannot read `.env.local`,
# so keeping it there is what makes `npm run db:push` / `db:seed` work.
 
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
AUTH_BYPASS="false"
 
# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long!"
JWT_ACCESS_EXPIRES="7d"
JWT_REFRESH_EXPIRES="30d"
 
# Cookies
COOKIE_SECURE="false"
 
# OTP
#
# The fixed dev code is only used by communities that cannot actually deliver an
# OTP — i.e. no WhatsApp API credentials saved. The moment one community's
# credentials are stored, that community issues real codes while the rest keep
# working on the fixed one. Nothing to switch per tenant.
#
# OTP_DEV_MODE is a kill-switch, not a feature flag: it is forced off whenever
# NODE_ENV=production, because the fixed code is accepted without reading any
# database row.
OTP_DEV_MODE="true"
OTP_DEV_CODE="1234"
OTP_EXPIRY_MINUTES="5"
OTP_LENGTH="6"
# Fallback only — the real code length now comes back from /api/auth/otp.
NEXT_PUBLIC_OTP_LENGTH="4"

# Encryption of provider credentials stored in the database
# (CommunityIntegration — the per-community ARTHIX WhatsApp keys).
#
# Generate with: openssl rand -base64 32
#
# ⚠ CHANGING THIS MAKES EVERY STORED INTEGRATION CREDENTIAL UNREADABLE. There is
# no re-encrypt script. To rotate: blank the WhatsApp fields for every community
# in the Main Admin panel, change the key, then re-enter them.
#
# Deliberately separate from JWT_ACCESS_SECRET — rotating a JWT secret is
# routine and must not destroy credentials as a side effect.
ENCRYPTION_KEY="change-me-encryption-key-min-32-chars!!"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
 
# Nodemailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Samaj App <noreply@samaj.app>"
 
# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
 
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
 
# Security
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
CORS_ORIGIN="http://localhost:3000"
CSRF_SECRET="change-me-csrf-secret-min-32-chars"
UPLOAD_MAX_BYTES="5242880"
 
# Domain routing (local uses *.localhost)
NEXT_PUBLIC_ROOT_DOMAIN="localhost"
NEXT_PUBLIC_APP_PROTOCOL="http"
NEXT_PUBLIC_APP_PORT="3000"
 
 # Database connection.
#
# This lives in `.env` (not `.env.local`) on purpose: the Prisma CLI only reads
# `.env`, while Next.js reads `.env` AND `.env.local`. Keeping DATABASE_URL here
# means `npm run db:push` / `db:seed` / `db:migrate` / `db:studio` work, with no
# duplicated value. Everything else stays in `.env.local`.
#
# MySQL (XAMPP default — empty password)
DATABASE_URL="mysql://root:@localhost:3306/community_app"
